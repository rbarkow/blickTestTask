{%- style -%}
  .section {
    display: block;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{{ 'section-blk-product-features.css' | asset_url | stylesheet_tag }}

<div id="BlkProductFeatures-{{ section.id }}" class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}" data-section="{{ section.id }}">
  <div class="page-width blk-product-features-page-width">
    <div class="blk-product-features {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- for block in section.blocks -%}
        <div class="blk-product-features__item">
          <div class="blk-product-features__item__icon">
            {%- if block.settings.image == null -%}
              {%- if block.settings.icon != 'none' -%}
                {%- assign file = block.settings.icon | replace: '_', '-' | prepend: 'icon-' | append: '.svg' -%}
                {{ file | inline_asset_content }}
              {%- endif -%}
            {%- else -%}
              <img
                src="{{ block.settings.image | image_url }}"
                {% if block.settings.image.alt != blank %}
                  alt="{{ block.settings.image.alt | escape }}"
                {% else %}
                  role="presentation"
                {% endif %}
                height="57px"
                width="auto"
                loading="lazy"
              >
            {%- endif -%}
          </div>
          
          <div>
            <div class="blk-product-features__item__title">
              {{ block.settings.title }}
            </div>
            <div class="blk-product-features__item__text">
              {{ block.settings.text }}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

